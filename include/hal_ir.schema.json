{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://llm-compileforge/schemas/hal_ir.schema.json",
  "title": "HAL IR Schema",
  "description": "JSON Schema for hal_ir.json — the Hardware Abstraction Layer Intermediate Representation contract between the Python compiler and Rust runtime (Path B).",
  "type": "object",
  "properties": {
    "model_name": {
      "type": "string",
      "description": "Model identifier (e.g. 'opt-125m')"
    },
    "num_functions": {
      "type": "integer",
      "minimum": 0,
      "description": "Total number of HAL functions in this graph"
    },
    "functions": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/HalFunction"
      }
    }
  },
  "definitions": {
    "ShapeElement": {
      "description": "A single dimension — may be an integer (static) or string (dynamic, '?')",
      "anyOf": [
        {"type": "integer"},
        {"type": "string"}
      ]
    },
    "HalTensorDef": {
      "type": "object",
      "description": "Tensor metadata for a function input or output",
      "properties": {
        "name": {
          "type": "string",
          "description": "SSA name (e.g. '%arg0', '%42')"
        },
        "shape": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ShapeElement"
          }
        },
        "dtype": {
          "type": "string",
          "description": "Data type: 'f32', 'f16', 'i64', 'i32', etc."
        },
        "consumed_internally": {
          "type": "boolean",
          "description": "When true, this tensor is NOT propagated to subsequent functions as a cross-function wire"
        }
      }
    },
    "HalWeightEntry": {
      "type": "object",
      "description": "A weight entry in a function's weights list",
      "properties": {
        "name": {
          "type": "string",
          "description": "Weight name (e.g. 'model.decoder.layers.0.self_attn.k_proj.weight')"
        },
        "shape": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dtype": {
          "type": "string",
          "description": "Weight data type (e.g. 'f32')"
        },
        "hal_name": {
          "type": "string",
          "description": "HAL-internal weight identifier"
        },
        "ssa": {
          "type": "string",
          "description": "SSA name produced by the weight op (e.g. '%0')"
        }
      }
    },
    "HalOp": {
      "type": "object",
      "description": "A single HAL operation",
      "properties": {
        "op": {
          "type": "string",
          "description": "Operation name: 'matmul', 'add', 'reshape', 'transpose', 'softmax', etc."
        },
        "kind": {
          "type": "string",
          "description": "Sub-type qualifier (e.g. 'gather' for 'element_wise' ops)"
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "SSA references for operands"
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "SSA names for results"
        },
        "weight": {
          "type": "string",
          "description": "Optional weight SSA reference"
        },
        "shape": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ShapeElement"
          },
          "description": "Op shape metadata (e.g. reshape targets)"
        },
        "value": {
          "type": "number",
          "description": "Scalar value attribute (e.g. for fill, attention scale)"
        },
        "input_dtypes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Dtype annotations for each input tensor"
        },
        "output_dtypes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Dtype annotations for each output tensor"
        },
        "dims": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "description": "Dimension permutation for transpose ops"
        },
        "dim": {
          "type": "integer",
          "description": "Dimension index for shape_of ops"
        }
      }
    },
    "HalFunction": {
      "type": "object",
      "description": "A single HAL function (entry point / sub-graph)",
      "properties": {
        "name": {
          "type": "string",
          "description": "Function name (e.g. 'main_0', 'main_1a', 'main_1b')"
        },
        "layer": {
          "type": ["integer", "null"],
          "description": "Decoder layer index (null for non-decoder functions)"
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/HalTensorDef"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/HalTensorDef"
          }
        },
        "weights": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/HalWeightEntry"
          }
        },
        "constants": {
          "type": "array",
          "description": "Compile-time constant values (always empty array in current output)"
        },
        "weight_inputs": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Mapping from SSA name to weight parameter name"
        },
        "block_table": {
          "type": "boolean",
          "description": "Present on KV-cache functions (main_Xa, main_Xb)"
        },
        "ops": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/HalOp"
          }
        }
      }
    }
  }
}
